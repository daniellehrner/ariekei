{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "svelte",
      "vite/client"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "ui/src/**/*.ts",
    "ui/src/**/*.svelte"
  ],
  "exclude": [
    "ui/src/**/*.test.ts"
  ]
}
