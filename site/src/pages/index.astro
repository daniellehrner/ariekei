import '@fontsource/jetbrains-mono/400.css';
import '../../../ui/src/tokens.css';
import '../styles/home.css';
import logo from '../assets/logo.svg?raw';
import Shot from '../components/Shot.astro';
import DownloadButton from '../components/DownloadButton.astro';
import { latestRelease, platformNames, releasesPage, repo, type Platform } from '../lib/release';

const release = await latestRelease();
const platforms: Platform[] = ['linux', 'macos', 'windows'];
const title = 'Ariekei — a review workbench for coding agents';
const description =
  'Every pull request, issue and task gets its own git worktree and its own Claude Code session. The Inbox puts what needs you first; you review the agent’s work and send comments to GitHub or back to the agent.';
const canonical = Astro.site ? new URL('/', Astro.site).href : undefined;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <a class="brand" href="/" aria-label="Ariekei home"><Fragment set:html={logo} /><span>Ariekei</span></a>
      <nav aria-label="Site">
        <a href="/docs/manual/">Docs</a>
        <a href={releasesPage}>Releases</a>
        <a href={repo}>GitHub</a>
      </nav>
    </header>

    <main>
      <section class="hero wrap">
        <h1>A review workbench for coding agents.</h1>
        <p class="lead">
          Every pull request, issue and task gets its own git worktree and its own Claude Code session. The Inbox puts
          what needs you first; you review the agent’s work and send comments to GitHub or back to the agent.
        </p>
        <div class="actions">
          <DownloadButton release={release} />
          <a class="button" href={repo}>View on GitHub</a>
        </div>
        <p class="fine">
          Free and open source (Apache-2.0) · Runs on your machine · Uses your own <code>claude</code> and <code>gh</code> ·
          Linux, macOS and Windows
        </p>
      </section>

      <div class="wrap hero-shot">
        <Shot
          name="drafts"
          eager
          alt="Ariekei with the Inbox on the left and the review of a pull request on the right: a side-by-side diff, a draft comment, and a banner saying the agent is waiting for permission."
        />
      </div>

      <section class="wrap strip" aria-label="What Ariekei is">
        <div>
          <h2><span class="mark agent" aria-hidden="true"></span>The agent writes the code</h2>
          <p>
            Your installed <code>claude</code> runs unmodified in an embedded terminal, in the item’s worktree, with the PR or
            issue as context. Your settings, your plan, your permissions.
          </p>
        </div>
        <div>
          <h2><span class="mark you" aria-hidden="true"></span>You review it</h2>
          <p>
            Ariekei is where you read the changes, comment and decide. It is not an IDE: for deep navigation or debugging,
            open the same worktree in your editor.
          </p>
        </div>
        <div>
          <h2><span class="mark gh" aria-hidden="true"></span>GitHub stays the record</h2>
          <p>
            Pull requests, issues, reviews and checks come from GitHub through your <code>gh</code> login. Works with any
            language: the diff comes from git.
          </p>
        </div>
      </section>

      <section class="wrap feature">
        <div class="text">
          <p class="kicker">Inbox</p>
          <h2>What needs you, first.</h2>
          <p>
            Starred, tasks, assigned, approved, review requested, your PRs, reviewed and the ones you added: each item sits
            in the first section that fits, ordered by attention. The agent needs you, CI is failing, new comments, ready
            for review.
          </p>
          <p>Notifications for the same events, in the window or from the OS when Ariekei is in the background.</p>
          <a class="more" href="/docs/manual/#4-the-inbox">The Inbox in the manual</a>
        </div>
        <Shot name="inbox" sizes="(min-width: 860px) 700px, 100vw" alt="The Inbox, grouped into sections, next to the overview of a pull request with its checks and reviews." />
      </section>

      <section class="wrap feature flip">
        <div class="text">
          <p class="kicker">Worktrees</p>
          <h2>One worktree and one agent per item.</h2>
          <p>
            Start working on a PR and it gets a worktree on its branch, next to your clone. An issue gets a new branch; a
            task needs neither, and the PRs and issues its agent opens are linked under it.
          </p>
          <p>
            Agents keep their conversation across restarts. Merged or closed items are cleaned up, without ever losing
            uncommitted or unpushed work.
          </p>
          <a class="more" href="/docs/lifecycle/">Issues, tasks and cleanup</a>
        </div>
        <Shot name="task" sizes="(min-width: 860px) 700px, 100vw" alt="A task in Ariekei with the pull request its agent opened, listed under the task in the Inbox." />
      </section>

      <section class="wrap feature">
        <div class="text">
          <p class="kicker">Review</p>
          <h2>Read the change, then say what you think.</h2>
          <p>
            All changes against the base branch or one commit at a time, in a review order instead of alphabetical, with
            keyboard navigation. Works without a worktree for other people’s PRs.
          </p>
          <p>
            Comments go to GitHub as a review, or to the agent. Select code and ask the agent about it: the file, lines
            and code go along.
          </p>
          <a class="more" href="/docs/review/">How the review works</a>
        </div>
        <Shot name="ask-agent" sizes="(min-width: 860px) 700px, 100vw" alt="Selected lines in the diff and the Ask the agent box, with a question about the code." />
      </section>

      <section class="wrap flow" aria-labelledby="flow-title">
        <h2 id="flow-title">How it fits together</h2>
        <ol>
          <li>
            <span class="mark gh" aria-hidden="true"></span>
            <h3>GitHub</h3>
            <p>PRs and issues reach the Inbox through your <code>gh</code>. Or start a task with no PR yet.</p>
          </li>
          <li>
            <span class="mark tree" aria-hidden="true"></span>
            <h3>Worktree</h3>
            <p><code>../clone_pr8012</code> on the PR’s branch: your clone stays as it is.</p>
          </li>
          <li>
            <span class="mark agent" aria-hidden="true"></span>
            <h3>Agent</h3>
            <p>Claude Code works there. Its hooks tell Ariekei when it is working, needs you or is done.</p>
          </li>
          <li>
            <span class="mark you" aria-hidden="true"></span>
            <h3>You</h3>
            <p>Review the diff. Send comments back to the agent, or to GitHub as a review.</p>
          </li>
        </ol>
      </section>

      <section class="wrap install" id="install" aria-labelledby="install-title">
        <h2 id="install-title">Install</h2>
        {
          release ? (
            <div class="platforms">
              {platforms.map((p) => {
                const files = release.downloads.filter((d) => d.platform === p);
                return (
                  <div class="platform">
                    <h3>{platformNames[p]}</h3>
                    {files.length ? (
                      <ul>
                        {files.map((d) => (
                          <li>
                            <a href={d.url}>{d.label}</a>
                          </li>
                        ))}
                      </ul>
                    ) : (
                      <p>
                        Not in this release: see <a href={release.url}>the release page</a>.
                      </p>
                    )}
                  </div>
                );
              })}
              <p class="fine">
                Version {release.version}. <a href={release.url}>Release notes</a> · <a href={releasesPage}>All releases</a>
              </p>
            </div>
          ) : (
            <p>
              There is no release yet. Until then, build Ariekei from source (below), or watch the{' '}
              <a href={releasesPage}>Releases page</a>.
            </p>
          )
        }
        <div class="notes">
          <div>
            <h3>You need</h3>
            <ul>
              <li><code>git</code></li>
              <li>The GitHub CLI <code>gh</code>, logged in (<code>gh auth login</code>). Ariekei has no login of its own.</li>
              <li>Claude Code (<code>claude</code>), with your own settings and plan.</li>
              <li>A local clone of the repository, with a GitHub remote.</li>
            </ul>
          </div>
          <div>
            <h3>Unsigned builds</h3>
            <p>
              The builds are not signed with a developer certificate yet. On macOS, when the first launch is blocked, allow
              it in System Settings → Privacy &amp; Security → Open Anyway. On Windows, choose More info → Run anyway.
            </p>
          </div>
        </div>
        <details class="source">
          <summary>Build from source</summary>
          <p>Rust 1.88+, Node 22+, and on Linux the WebKitGTK 4.1 and GTK 3 development packages.</p>
          <pre><code>git clone {repo}.git
cd ariekei
npm ci
npx tauri build</code></pre>
        </details>
      </section>

      <section class="wrap faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Questions</h2>
        <details>
          <summary>Is it free?</summary>
          <p>Yes. Ariekei is open source under the Apache License 2.0. There is no account and nothing to pay for; Claude Code uses your own plan.</p>
        </details>
        <details>
          <summary>What leaves my machine?</summary>
          <p>
            Nothing goes to Ariekei: there is no server and no telemetry. GitHub is reached through your <code>gh</code> and
            <code>git</code>, and the agent is your <code>claude</code>, each with its own login.
          </p>
        </details>
        <details>
          <summary>Does it replace my editor?</summary>
          <p>
            No. Ariekei is for steering and reviewing agents. Code intelligence, navigation and debugging stay in your IDE,
            which can open the same worktree.
          </p>
        </details>
        <details>
          <summary>Which agents does it support?</summary>
          <p>Claude Code, run unmodified. Its status comes from Claude Code’s hooks.</p>
        </details>
        <details>
          <summary>Which languages?</summary>
          <p>Any. The diff comes from git, every file type is syntax-highlighted, and the agent works in any language.</p>
        </details>
        <details>
          <summary>Where does my data live?</summary>
          <p>
            In a local database in the app’s data directory, plus the worktrees next to your clone.
            <a href="/docs/manual/#16-where-your-data-lives">Details in the manual</a>.
          </p>
        </details>
      </section>

      <section class="wrap closing">
        <h2>Let the agent write it. Review it here.</h2>
        <div class="actions">
          <DownloadButton release={release} />
          <a class="button" href="/docs/manual/">Read the manual</a>
        </div>
      </section>
    </main>

    <footer class="wrap bottom">
      <span>Ariekei · Apache-2.0</span>
      <nav aria-label="Footer">
        <a href="/docs/manual/">Manual</a>
        <a href={releasesPage}>Releases</a>
        <a href={`${repo}/issues`}>Issues</a>
        <a href={repo}>GitHub</a>
      </nav>
    </footer>

    <script is:inline>
      // Show the download button for the visitor's OS (see DownloadButton.astro).
      (() => {
        const ua = (navigator.userAgentData && navigator.userAgentData.platform) || navigator.userAgent;
        const os = /mac/i.test(ua) ? 'macos' : /win/i.test(ua) ? 'windows' : /linux|x11/i.test(ua) && !/android/i.test(ua) ? 'linux' : null;
        for (const box of document.querySelectorAll('.download')) {
          const mine = os && box.querySelector(`[data-download="${os}"]`);
          if (!mine) continue;
          mine.hidden = false;
          box.querySelector('[data-download="any"]').hidden = true;
        }
      })();
    </script>
  </body>
</html>
