// The primary download button. One button per platform is rendered; the page's script shows
// the one for the visitor's OS. Without the script (or for an OS without a build) the generic
// button, which scrolls to all downloads, stays.
import { platformNames, type Platform, type Release } from '../lib/release';

interface Props {
  release: Release | null;
}
const { release } = Astro.props;
const platforms: Platform[] = ['linux', 'macos', 'windows'];
const first = (p: Platform) => release?.downloads.find((d) => d.platform === p);
const version = release ? `v${release.version}` : '';
const icon =
  '<svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2.5v8M4.5 7L8 10.5 11.5 7M3 13.5h10"/></svg>';
---

<div class="download">
  <a class="button primary" href="#install" data-download="any">
    <Fragment set:html={icon} />{release ? 'Download' : 'Install'}{version && <span class="version">{version}</span>}
  </a>
  {
    platforms.map((p) => {
      const d = first(p);
      return (
        d && (
          <a class="button primary" href={d.url} data-download={p} hidden>
            <Fragment set:html={icon} />
            Download for {platformNames[p]}
            <span class="version">{version}</span>
          </a>
        )
      );
    })
  }
</div>

<style>
  .download {
    display: contents;
  }
  .version {
    padding: 2px 7px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--text-on-accent) 18%, transparent);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: var(--fw-medium);
  }
</style>
