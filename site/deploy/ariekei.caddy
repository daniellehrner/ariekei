# The Ariekei website: static files from site/deploy.sh (see site/README.md in the Ariekei repo).
# Loaded by the server's /etc/caddy/Caddyfile through `import /etc/caddy/sites/*.caddy`.
# deploy.sh replaces ARIEKEI_DOMAIN with the site's domain.
ARIEKEI_DOMAIN {
	root * /var/www/ariekei
	encode zstd gzip
	file_server

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
		# Inline scripts: the theme and the download button; wasm: the docs search (Pagefind).
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
		-Server
	}

	# Astro names its assets by content hash; everything else may change with any deploy.
	@hashed path /_astro/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@other not path /_astro/*
	header @other Cache-Control "no-cache"

	handle_errors 404 {
		rewrite * /404.html
		file_server
	}
}
